<% layout('boilerplate.ejs') %>

<style>
  .form-actions {
    display: flex;
    gap: 1rem;
    margin-top: 1.5rem;
    align-items: center;
  }

  .cancel-btn {
    padding: 0.6rem 1.2rem;
    border-radius: 8px;
    font-size: 0.9rem;
    font-weight: 600;
    border: 1px solid #8b949e;
    color: #8b949e;
    background: transparent;
    text-decoration: none;
    transition: all 0.2s;
    cursor: pointer;
  }

  .cancel-btn:hover {
    background: rgba(139, 148, 158, 0.1);
    border-color: #c9d1d9;
    color: #c9d1d9;
  }
</style>

<div class="form-wrapper">
    <div class="form-container">
        <h2><i class="fa-solid fa-pen"></i> Edit Profile Notes</h2>
        <p class="text-muted">Add tags and personal notes for <strong><%= profile.username %></strong></p>

        <form action="/profile/<%= profile._id %>?_method=PUT" method="POST" class="listing-form">
            <div class="form-group">
                <label>Tags (comma separated)</label>
                <input type="text" name="profile[tags]" class="form-control"
                    value="<%= profile.tags ? profile.tags.join(', ') : '' %>"
                    placeholder="e.g. fullstack, open-source, react">
            </div>

            <div class="form-group">
                <label>Notes</label>
                <textarea name="profile[notes]" class="form-control" rows="5"
                    placeholder="Add your notes about this developer..."><%= profile.notes || '' %></textarea>
            </div>

            <div class="form-actions">
                <button type="submit" class="submit-btn">
                    <i class="fa-solid fa-check"></i> Update Profile
                </button>
                <a href="/profile/show/<%= profile._id %>" class="cancel-btn">
                    <i class="fa-solid fa-xmark"></i> Cancel
                </a>
            </div>
        </form>
    </div>
</div>