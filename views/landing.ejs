<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>GitHub Portfolio Analyzer</title>
    <link rel="icon" type="image/png" href="https://github.githubassets.com/favicons/favicon-dark.svg">
    <link rel="preconnect" href="https://fonts.googleapis.com">
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
    <link href="https://fonts.googleapis.com/css2?family=Inter:wght@400;500;600;700;800;900&display=swap" rel="stylesheet">
    <link rel="stylesheet" href="/style.css">
    <link href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.8/dist/css/bootstrap.min.css" rel="stylesheet" integrity="sha384-sRIl4kxILFvY47J16cr9ZwB07vP4J8+LH7qKQnuqkuIAvNWLzeN8tE5YBujZqJLB" crossorigin="anonymous">
    <link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/7.0.1/css/all.min.css" integrity="sha512-2SwdPD6INVrV/lHTZbO2nodKhrnDdJK9/kg2XD1r9uGqPo1cUbujc+IYdlYdEErWNu69gVcYgdxlmVmzTWnetw==" crossorigin="anonymous" referrerpolicy="no-referrer" />
</head>
<body class="landing-body">
    <div class="landing-container">
        <!-- Animated Background Particles -->
        <div class="particles">
            <div class="particle"></div>
            <div class="particle"></div>
            <div class="particle"></div>
            <div class="particle"></div>
            <div class="particle"></div>
            <div class="particle"></div>
        </div>

        <!-- Main Content -->
        <div class="landing-content">
            <!-- Logo / Brand -->
            <div class="landing-brand">
                <div class="brand-icon">
                    <i class="fa-brands fa-github"></i>
                </div>
                <h1 class="landing-title">
                    <span class="title-gradient">GitHub Portfolio Analyzer</span>
                </h1>
                <p class="landing-tagline">Analyze. Score. Track. Elevate.</p>
            </div>

            <!-- Welcome Section -->
            <div class="welcome-section">
                <h2 class="welcome-heading">Welcome to the Future of Developer Insights</h2>
                <p class="welcome-text">
                    Unlock the power of AI-driven GitHub portfolio analysis. Our platform dives deep into developer profiles, 
                    evaluating code quality, skills, contributions, and growth potential — all in one place.
                </p>
            </div>

            <!-- Features Grid -->
            <div class="features-grid">
                <div class="feature-card">
                    <div class="feature-icon">
                        <i class="fa-solid fa-robot"></i>
                    </div>
                    <h3>AI-Powered Analysis</h3>
                    <p>Get intelligent insights on code quality, skills, and developer level with advanced AI evaluation.</p>
                </div>
                <div class="feature-card">
                    <div class="feature-icon">
                        <i class="fa-solid fa-chart-line"></i>
                    </div>
                    <h3>Contribution Scoring</h3>
                    <p>Track and score developer contributions with a comprehensive 0-100 rating system.</p>
                </div>
                <div class="feature-card">
                    <div class="feature-icon">
                        <i class="fa-solid fa-code"></i>
                    </div>
                    <h3>Language & Skill Tracking</h3>
                    <p>Identify top programming languages, skills, and areas of expertise automatically.</p>
                </div>
                <div class="feature-card">
                    <div class="feature-icon">
                        <i class="fa-solid fa-lightbulb"></i>
                    </div>
                    <h3>Smart Recommendations</h3>
                    <p>Receive personalized suggestions to level up your GitHub profile and coding skills.</p>
                </div>
            </div>

            <!-- CTA Button -->
            <div class="cta-section">
                <a href="/profile" class="cta-button">
                    <span>Explore Dashboard</span>
                    <i class="fa-solid fa-arrow-right"></i>
                </a>
                <p class="cta-subtext">Already have an account? <a href="/login" class="cta-link">Sign in</a> or <a href="/signup" class="cta-link">Sign up</a></p>
            </div>

            <!-- Footer -->
            <div class="landing-footer">
                <div class="footer-divider"></div>
                <p class="created-by">
                    <i class="fa-solid fa-heart" style="color: var(--accent-red);"></i>
                    Created by <strong>Akhilesh Lonkar</strong>
                </p>
                <p class="footer-tagline">Built with passion for the developer community</p>
            </div>
        </div>
    </div>

    <script src="https://cdn.jsdelivr.net/npm/bootstrap@5.3.8/dist/js/bootstrap.bundle.min.js" integrity="sha384-FKyoEForCGlyvwx9Hj09JcYn3nv7wiPVlz7YYwJrWVcXK/BmnVDxM+D2scQbITxI" crossorigin="anonymous"></script>
</body>
</html>
